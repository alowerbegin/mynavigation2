# 双 Action 综合 RViz 视图，显示 fixed_path_exec 和 lattice_exec 的成本地图、路径及统一地图。

Panels:
- Class: rviz_common/Displays
  Help Height: 0
  Name: Displays
  Property Tree Widget:
    Expanded:
    - /Global Options1
    Splitter Ratio: 0.5833333134651184
  Tree Height: 606
- Class: rviz_common/Tool Properties
  Expanded:
  - /Publish Point1
  Name: Tool Properties
  Splitter Ratio: 0.5886790156364441
- Class: rviz_common/Views
  Expanded:
  - /Current View1
  Name: Views
  Splitter Ratio: 0.5
- Class: nav2_rviz_plugins/Navigation 2
  Name: Navigation 2
# 全局坐标系、显示项、交互工具和视角设置。
Visualization Manager:
  Class: ''
  Displays:
  - Alpha: 1
    Class: rviz_default_plugins/Map
    Color Scheme: map
    Draw Behind: true
    Enabled: true
    Name: Map
    Topic:
      Depth: 1
      Durability Policy: Transient Local
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /map
    Use Timestamp: false
    Value: true
  - Class: rviz_default_plugins/TF
    Enabled: true
    Frame Timeout: 15
    Frames:
      All Enabled: true
    Marker Scale: 0.35
    Name: TF
    Show Arrows: true
    Show Axes: true
    Show Names: false
    Tree: {}
    Update Interval: 0
    Value: true
  - Alpha: 1
    Autocompute Intensity Bounds: true
    Autocompute Value Bounds:
      Max Value: 10
      Min Value: -10
      Value: true
    Axis: Z
    Channel Name: intensity
    Class: rviz_default_plugins/LaserScan
    Color: 255; 255; 255
    Color Transformer: Intensity
    Decay Time: 0
    Enabled: true
    Invert Rainbow: false
    Max Color: 255; 255; 255
    Max Intensity: 0
    Min Color: 0; 0; 0
    Min Intensity: 0
    Name: LaserScan
    Position Transformer: XYZ
    Selectable: true
    Size (Pixels): 3
    Size (m): 0.009999999776482582
    Style: Points
    Topic:
      Depth: 5
      Durability Policy: Volatile
      Filter size: 100
      History Policy: Keep Last
      Reliability Policy: Best Effort
      Value: /c200_lidar_node/scan
    Use Fixed Frame: true
    Use rainbow: true
    Value: true
  - Class: rviz_common/Group
    Name: Lattice global
    Enabled: true
    Displays:
    - Alpha: 0.3
      Class: rviz_default_plugins/Map
      Color Scheme: costmap
      Draw Behind: false
      Enabled: true
      Name: Lattice global costmap
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        Filter size: 100
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /lattice_exec/global_costmap/costmap
      Update Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /lattice_exec/global_costmap/costmap_updates
      Use Timestamp: false
      Value: true
    - Class: rviz_default_plugins/Polygon
      Enabled: true
      Value: true
      Topic:
        Value: /lattice_exec/global_costmap/published_footprint
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Name: Lattice global footprint
      Color: 255; 190; 70
      Alpha: 1.0
  - Class: rviz_common/Group
    Name: Lattice local
    Enabled: true
    Displays:
    - Alpha: 0.35
      Class: rviz_default_plugins/Map
      Color Scheme: costmap
      Draw Behind: false
      Enabled: true
      Name: Lattice local costmap
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        Filter size: 100
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /lattice_exec/local_costmap/costmap
      Update Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /lattice_exec/local_costmap/costmap_updates
      Use Timestamp: false
      Value: true
    - Class: rviz_default_plugins/Polygon
      Enabled: true
      Value: true
      Topic:
        Value: /lattice_exec/local_costmap/published_footprint
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Name: Lattice local footprint
      Color: 255; 150; 40
      Alpha: 1.0
  - Class: rviz_common/Group
    Name: Fixed local
    Enabled: true
    Displays:
    - Alpha: 0.25
      Class: rviz_default_plugins/Map
      Color Scheme: costmap
      Draw Behind: false
      Enabled: true
      Name: Fixed local costmap
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        Filter size: 100
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /fixed_path_exec/local_costmap/costmap
      Update Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /fixed_path_exec/local_costmap/costmap_updates
      Use Timestamp: false
      Value: true
    - Class: rviz_default_plugins/Polygon
      Enabled: true
      Value: true
      Topic:
        Value: /fixed_path_exec/local_costmap/published_footprint
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Name: Fixed local footprint
      Color: 50; 200; 255
      Alpha: 1.0
  - Class: rviz_default_plugins/Path
    Enabled: true
    Value: true
    Topic:
      Depth: 1
      Durability Policy: Transient Local
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /fixed_path_plan
    Name: Fixed path
    Color: 50; 210; 255
    Line Width: 0.035
  # 固定路径的左右边界与采样点由 MarkerArray 提供，瞬态本地 QoS 支持后打开 RViz 时接收保留消息。
  - Class: rviz_default_plugins/MarkerArray
    Enabled: true
    Value: true
    Name: Fixed path boundaries
    Namespaces: {}
    Topic:
      Depth: 1
      Durability Policy: Transient Local
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /fixed_path_boundaries
  - Class: rviz_default_plugins/Path
    Enabled: true
    Value: true
    Topic:
      Depth: 1
      Durability Policy: Transient Local
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /autonomous_fixed/plan
    Name: Lattice frozen path
    Color: 255; 190; 70
    Line Width: 0.035
  Enabled: true
  Global Options:
    Background Color: 35; 38; 42
    Fixed Frame: map
    Frame Rate: 20
  Name: root
  Tools:
  - Class: rviz_default_plugins/MoveCamera
  - Class: rviz_default_plugins/Select
  - Class: rviz_default_plugins/FocusCamera
  - Class: rviz_default_plugins/Measure
    Line color: 128; 128; 0
  - Class: rviz_default_plugins/SetInitialPose
    Covariance x: 0.25
    Covariance y: 0.25
    Covariance yaw: 0.06853891909122467
    Topic:
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /initialpose
  - Class: rviz_default_plugins/PublishPoint
    Single click: true
    Topic:
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /clicked_point
  - Class: nav2_rviz_plugins/GoalTool
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Angle: 0
      Class: rviz_default_plugins/TopDownOrtho
      Enable Stereo Rendering:
        Stereo Eye Separation: 0.05999999865889549
        Stereo Focal Distance: 1
        Swap Stereo Eyes: false
        Value: false
      Invert Z Axis: false
      Name: Current View
      Near Clip Distance: 0.009999999776482582
      Scale: 45
      Target Frame: base_link
      Value: TopDownOrtho (rviz_default_plugins)
      X: 0
      Y: 0
    Saved: null
# 窗口位置和尺寸，仅影响本机布局。
Window Geometry:
  Width: 1400
  Height: 900
  X: 30
  Y: 30
  Hide Left Dock: false
  Hide Right Dock: true
